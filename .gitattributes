* text=auto eol=lf
*.ps1 text eol=crlf

# binary assets (enable Git LFS with `git lfs install` before adding large media)
*.png binary
*.jpg binary
*.ttf binary
*.otf binary
*.cube text
*.mp3 filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.mov filter=lfs diff=lfs merge=lfs -text
